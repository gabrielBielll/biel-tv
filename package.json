{
  "name": "biel-tv",
  "private": true,
  "description": "Biel TV — canal de TV linear 24/7, 100% serverless (Cloudflare Workers + D1 + R2)",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --filter @bieltv/stream dev",
    "deploy": "pnpm --filter @bieltv/stream deploy",
    "db:migrate:local": "pnpm --filter @bieltv/stream db:migrate:local",
    "media:test": "bash scripts/make-test-media.sh",
    "media:put:local": "bash scripts/r2-put-local.sh",
    "seed:local": "node scripts/seed-epg.mjs",
    "verify:stream": "node scripts/verify-stream.mjs",
    "ingest": "node packages/pipeline/src/cli.mjs ingest",
    "registra:pendentes": "node scripts/registra-pendentes.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs",
    "web:dev": "pnpm --filter @bieltv/web dev",
    "web:build": "pnpm --filter @bieltv/web build",
    "web:deploy": "VITE_API_BASE=https://biel-tv-stream.biel-cesa95.workers.dev pnpm --filter @bieltv/web build && pnpm --filter @bieltv/stream pages:deploy",
    "verify:web": "node scripts/verify-web.mjs",
    "factory": "node scripts/factory-local.mjs",
    "drena:local": "bash scripts/drena-local.sh",
    "monitora:fila": "bash scripts/monitora-fila.sh",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:canais": "node scripts/verify-canais.mjs",
    "verify:blocos": "node scripts/verify-blocos.mjs",
    "verify:ancoras": "node scripts/verify-ancoras.mjs",
    "verify:variacoes": "node --import ./scripts/_ts-registra.mjs scripts/verify-fabrica-variacoes.mjs",
    "verify:guia": "node scripts/verify-guia.mjs",
    "verify:diretor": "node scripts/verify-diretor.mjs",
    "verify:uploads": "node scripts/verify-uploads.mjs",
    "verify:promessas": "node scripts/verify-promessas.mjs",
    "verify:cortador": "node scripts/verify-cortador.mjs",
    "verify:cortador:v3": "node scripts/verify-cortador-v3.mjs",
    "verify:editorial": "node scripts/verify-editorial.mjs",
    "verify:votaton": "node scripts/verify-votaton.mjs",
    "verify:nomear": "node scripts/verify-nomear.mjs",
    "verify:marcador": "node scripts/verify-marcador.mjs",
    "verify:link": "node scripts/verify-link.mjs",
    "verify:playlist": "node scripts/verify-playlist.mjs",
    "verify:playback": "node scripts/verify-playback.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
